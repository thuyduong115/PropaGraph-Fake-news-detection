# Sao chép thành .env rồi sửa. .env không được commit.

# Thư mục chứa export/ tải từ Drive (VKU-Study/DACN2/v2/export). Đường dẫn tương đối tính từ
# gốc repo; Docker mount vào /app/artifacts (read-only).
ARTIFACTS_DIR=artifacts

# Backend chạy CPU là đủ (docs/development.md §7 quy tắc 4)
DEVICE=cpu

# Origin của frontend được gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173

# Đăng nhập (docs/accounts.md). Mật khẩu dưới đây chỉ dùng cho phát triển/demo nội bộ.
AUTH_REQUIRED=1
# Chuỗi ngẫu nhiên dài; trống thì phiên mất mỗi lần khởi động lại backend
AUTH_SECRET=
SESSION_HOURS=12
# Đặt 1 khi chạy sau HTTPS
COOKIE_SECURE=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
USER_USERNAME=user
USER_PASSWORD=user@123

# Chưa có export thật: python scripts/run.py devdata, rồi bỏ comment dòng dưới
# ARTIFACTS_DIR=.cache/dev-artifacts
